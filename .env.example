# Copy to .env.local and fill in. Never commit .env.local.
# All variables are read on the SERVER only. Do not rename them to NEXT_PUBLIC_*.

# Supabase project URL (Project Settings -> API / Data API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side key that bypasses RLS: the "service_role" key, or a new-style
# "secret" key (sb_secret_...). NEVER expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only key for personal-account Auth requests. If omitted, an
# isolated Auth client uses SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY.
SUPABASE_ANON_KEY=

# Optional canonical origin for signup-email redirects / POST origin checks.
# If set, match the browser URL, e.g. http://localhost:3000 or your HTTPS site.
APP_ORIGIN=

# fixture = no AI calls, use saved responses (Milestone 1, default)
# live    = call the AI API, fall back to saved responses on timeout/invalid output (Milestone 2)
AI_MODE=fixture

# Live AI timeout per step, in milliseconds.
AI_TIMEOUT_MS=8000

# Live AI provider: Groq (free tier, OpenAI-compatible). Get a key at console.groq.com.
# The agent's key: every AI text step (summaries, matching, briefs, extraction, decisions).
GROQ_API_KEY=

# Optional: a key for speech-to-text only (voice notes, voice intros, call and video
# recordings). Groq counts limits per ACCOUNT, so use a key from a different Groq
# account to give transcription its own limits. Empty = use GROQ_API_KEY.
# GROQ_TRANSCRIBE_API_KEY=

# Optional overrides (defaults shown). Any OpenAI-compatible API works:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b          # explanations, briefs, extraction, decisions
# AI_MODEL_LIGHT=openai/gpt-oss-20b     # summaries, check-ins, reading replies
# AI_MODEL_TRANSCRIBE=whisper-large-v3-turbo
# AI_DAILY_CALL_LIMIT=300               # live calls per server per day, then saved responses

# Calls: LiveKit Cloud (cloud.livekit.io), free "Build" plan, no card needed.
# Project -> Settings -> Keys. Server only. Without these, calls have no video,
# but joining, consent, recording and transcripts still work.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CALL_WINDOW_MINUTES=15   # optional: calls open only this long before the session (off for the demo)

# Hosted test version only: sign-in by ROLE (not personal accounts). Each
# device types one password once; it decides what that device may open and do.
# None set = no sign-in (local development). Use four different passwords.
# ENTREPRENEUR_PASSWORD=   # the entrepreneur (Pema) screens and actions
# MENTOR_PASSWORD=         # the mentor workspace: accept/decline, notes, the mentor side of calls
# YDF_PASSWORD=            # the YDF staff page (/ydf) and the demo controls (reset, fast-forward)
# DEMO_PASSWORD=           # the team: everything

# Call notifications (web push): "Pema is in the session room" on the other
# person's phone. Generate a pair once: npx web-push generate-vapid-keys
# Empty = no notifications (the Notify me button is hidden).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # shared with browsers (not a secret); needed at build time
# VAPID_PRIVATE_KEY=              # signs notifications: a secret
# VAPID_SUBJECT=https://your-app.vercel.app   # a contact URL sent to the push services

# Optional: only for the local Python diarizer (scripts/whisper_diarize.py).
# Accept pyannote/speaker-diarization-3.1 terms on Hugging Face, then paste a token.
# HF_TOKEN=
