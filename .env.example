# Copy to .env.local and fill in. Never commit .env.local.
# All variables are read on the SERVER only. Do not rename them to NEXT_PUBLIC_*.

# Supabase project URL (Project Settings -> API / Data API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side key that bypasses RLS: the "service_role" key, or a new-style
# "secret" key (sb_secret_...). NEVER expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# fixture = no AI calls, use saved responses (Milestone 1, default)
# live    = call the AI API, fall back to saved responses on timeout/invalid output (Milestone 2)
AI_MODE=fixture

# Live AI timeout per step, in milliseconds.
AI_TIMEOUT_MS=8000
